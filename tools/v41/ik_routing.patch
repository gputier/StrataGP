+void IMatrixCollector::dump_routing(const std::string & wname, const ggml_tensor * ids) {
+    if (!m_route_init) {
+        m_route_init = true;
+        if (const char * path = std::getenv("IK_IMATRIX_ROUTING")) {
+            m_route_out.open(path, std::ios::binary | std::ios::trunc);
+            // header: magic, then the number of experts chosen per token
+            const char magic[4] = {'R', 'T', 'R', '1'};
+            const int32_t n_used = (int32_t) ids->ne[0];
+            m_route_out.write(magic, sizeof(magic));
+            m_route_out.write((const char *) &n_used, sizeof(n_used));
+        }
+    }
+    if (!m_route_out.is_open()) {
+        return;
+    }
+    // one record per layer and per ubatch: the up projection is evaluated once per layer, fused or not
+    // sscanf returns 1 as soon as %d is read, so the literal tail is checked through %n (set only when it matched)
+    int il = -1;
+    int tail = 0;
+    if (std::sscanf(wname.c_str(), "blk.%d.ffn_up_exps%n", &il, &tail) != 1 || tail == 0) {
+        return;
+    }
+    // record: uint16 layer, then n_used x uint16 expert ids; the k-th record of a layer is token k
+    for (int row = 0; row < (int) ids->ne[1]; ++row) {
+        uint16_t rec[1 + 16];
+        GGML_ASSERT(ids->ne[0] <= 16);
+        rec[0] = (uint16_t) il;
+        for (int idx = 0; idx < (int) ids->ne[0]; ++idx) {
+            rec[1 + idx] = (uint16_t) *(const int32_t *) (m_ids.data() + row*ids->nb[1] + idx*ids->nb[0]);
+        }
+        m_route_out.write((const char *) rec, (1 + ids->ne[0]) * sizeof(uint16_t));
+    }
+    // flushed per call, so a window cut short keeps every token already evaluated
+    m_route_out.flush();
+}
