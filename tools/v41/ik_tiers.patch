diff --git a/tests/test-moe-tiers.cpp b/tests/test-moe-tiers.cpp
new file mode 100644
index 00000000..be870280
--- /dev/null
+++ b/tests/test-moe-tiers.cpp
@@ -0,0 +1,276 @@
+// Checks that routed experts split in quantization tiers give the same bits as one op over all the experts.
+// A tier sees the expert ids remapped to its own positions (-1 when the expert is in another tier).
+
+#include "ggml.h"
+#include "ggml-backend.h"
+#include "ggml-alloc.h"
+#include "ggml-backend-impl.h"
+
+#include <algorithm>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <random>
+#include <vector>
+
+namespace {
+
+constexpr int n_tiers  = 3;
+constexpr int n_expert = 24;
+constexpr int n_used   = 6;
+constexpr int n_tokens = 7;
+constexpr int n_dim    = 256; // input and ff size, a multiple of every block size under test
+constexpr float swiglu_limit = 2.0f;
+
+struct tier_table {
+    std::vector<std::vector<int>> members; // members[k]: increasing expert ids of tier k
+    std::vector<int32_t> map[n_tiers];     // map[k][e]: position of e in tier k, -1 when absent
+};
+
+tier_table make_table(std::mt19937 & rng) {
+    tier_table t;
+    for (;;) {
+        t.members.assign(n_tiers, {});
+        for (int e = 0; e < n_expert; ++e) {
+            t.members[rng() % n_tiers].push_back(e);
+        }
+        if (std::none_of(t.members.begin(), t.members.end(), [](const std::vector<int> & m) { return m.empty(); })) {
+            break;
+        }
+    }
+    for (int k = 0; k < n_tiers; ++k) {
+        t.map[k].assign(n_expert, -1);
+        for (size_t p = 0; p < t.members[k].size(); ++p) {
+            t.map[k][t.members[k][p]] = (int32_t) p;
+        }
+    }
+    return t;
+}
+
+// n_used distinct experts per token, stored with the row stride of a full [n_expert, n_tokens] top-k result
+std::vector<int32_t> make_ids(std::mt19937 & rng) {
+    std::vector<int32_t> ids(n_expert * n_tokens, 0);
+    std::vector<int32_t> perm(n_expert);
+    for (int t = 0; t < n_tokens; ++t) {
+        for (int e = 0; e < n_expert; ++e) perm[e] = e;
+        std::shuffle(perm.begin(), perm.end(), rng);
+        std::copy(perm.begin(), perm.begin() + n_used, ids.begin() + (size_t) t * n_expert);
+    }
+    return ids;
+}
+
+std::vector<float> make_floats(std::mt19937 & rng, size_t n, float scale) {
+    std::normal_distribution<float> dist(0.0f, scale);
+    std::vector<float> v(n);
+    for (auto & x : v) x = dist(rng);
+    return v;
+}
+
+// n_expert experts of [n_dim, n_dim] quantized one after the other
+std::vector<uint8_t> make_experts(std::mt19937 & rng, ggml_type type, size_t & expert_size) {
+    expert_size = ggml_row_size(type, n_dim) * n_dim;
+    std::vector<float> imatrix;
+    if (ggml_quantize_requires_imatrix(type)) {
+        imatrix.assign(n_dim, 1.0f);
+    }
+    std::vector<uint8_t> bytes(expert_size * n_expert);
+    for (int e = 0; e < n_expert; ++e) {
+        const auto src = make_floats(rng, (size_t) n_dim * n_dim, 0.1f);
+        const size_t written = ggml_quantize_chunk(type, src.data(), bytes.data() + e * expert_size, 0, n_dim, n_dim,
+                imatrix.empty() ? nullptr : imatrix.data(), nullptr);
+        if (written != expert_size) {
+            std::fprintf(stderr, "quantization of type %s wrote %zu bytes, expected %zu\n", ggml_type_name(type), written, expert_size);
+            std::exit(1);
+        }
+    }
+    return bytes;
+}
+
+struct weights {
+    ggml_tensor * full;
+    ggml_tensor * tier[n_tiers];
+};
+
+weights make_weights(ggml_context * ctx, ggml_type type, const std::vector<uint8_t> & bytes, size_t expert_size, const tier_table & table) {
+    weights w;
+    w.full = ggml_new_tensor_3d(ctx, type, n_dim, n_dim, n_expert);
+    std::memcpy(w.full->data, bytes.data(), bytes.size());
+    for (int k = 0; k < n_tiers; ++k) {
+        w.tier[k] = ggml_new_tensor_3d(ctx, type, n_dim, n_dim, (int64_t) table.members[k].size());
+        for (size_t p = 0; p < table.members[k].size(); ++p) {
+            std::memcpy((char *) w.tier[k]->data + p * expert_size, bytes.data() + table.members[k][p] * expert_size, expert_size);
+        }
+    }
+    return w;
+}
+
+ggml_tensor * up_gate(ggml_context * ctx, ggml_tensor * up, ggml_tensor * gate, ggml_tensor * cur, ggml_tensor * ids) {
+    ggml_tensor * par = ggml_moe_up_gate(ctx, up, gate, cur, ids, GGML_UNARY_OP_SILU);
+    *((float *) (par->op_params + 1)) = swiglu_limit;
+    return par;
+}
+
+// Compares, for one weight type, the single op over all experts with the sum over the tiers.
+bool check_type(ggml_type type, int n_threads, std::mt19937 & rng) {
+    const tier_table table = make_table(rng);
+    const std::vector<int32_t> ids_data = make_ids(rng);
+    const auto cur_data = make_floats(rng, (size_t) n_dim * n_tokens, 1.0f);
+    size_t expert_size = 0;
+    const auto up_bytes   = make_experts(rng, type, expert_size);
+    const auto gate_bytes = make_experts(rng, type, expert_size);
+    const auto down_bytes = make_experts(rng, type, expert_size);
+
+    // the memory is filled with NaN patterns: a result row the kernels do not write shows up in the comparison
+    std::vector<uint8_t> mem(64u << 20, 0xff);
+    ggml_init_params params = { mem.size(), mem.data(), false };
+    ggml_context * ctx = ggml_init(params);
+
+    const weights up   = make_weights(ctx, type, up_bytes,   expert_size, table);
+    const weights gate = make_weights(ctx, type, gate_bytes, expert_size, table);
+    const weights down = make_weights(ctx, type, down_bytes, expert_size, table);
+
+    ggml_tensor * cur = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, n_dim, 1, n_tokens);
+    std::memcpy(cur->data, cur_data.data(), ggml_nbytes(cur));
+
+    ggml_tensor * ids_full = ggml_new_tensor_2d(ctx, GGML_TYPE_I32, n_expert, n_tokens);
+    std::memcpy(ids_full->data, ids_data.data(), ggml_nbytes(ids_full));
+    ggml_tensor * ids = ggml_view_2d(ctx, ids_full, n_used, n_tokens, ids_full->nb[1], 0);
+
+    ggml_tensor * maps[n_tiers];
+    for (int k = 0; k < n_tiers; ++k) {
+        maps[k] = ggml_new_tensor_2d(ctx, GGML_TYPE_I32, 1, n_expert);
+        std::memcpy(maps[k]->data, table.map[k].data(), ggml_nbytes(maps[k]));
+    }
+
+    ggml_tensor * ref_mm    = ggml_mul_mat_id(ctx, up.full, cur, ids);
+    ggml_tensor * ref_par   = up_gate(ctx, up.full, gate.full, cur, ids);
+    ggml_tensor * ref_chain = ggml_mul_mat_id(ctx, down.full, ref_par, ids);
+
+    ggml_tensor * flat_ids = ggml_reshape_1d(ctx, ggml_cont(ctx, ids), ggml_nelements(ids));
+    ggml_tensor * tier_mm = nullptr;
+    ggml_tensor * tier_par_sum = nullptr;
+    ggml_tensor * tier_chain = nullptr;
+    for (int k = 0; k < n_tiers; ++k) {
+        ggml_tensor * tier_ids = ggml_reshape_2d(ctx, ggml_get_rows(ctx, maps[k], flat_ids), n_used, n_tokens);
+        ggml_tensor * mm    = ggml_mul_mat_id(ctx, up.tier[k], cur, tier_ids);
+        ggml_tensor * par   = up_gate(ctx, up.tier[k], gate.tier[k], cur, tier_ids);
+        ggml_tensor * chain = ggml_mul_mat_id(ctx, down.tier[k], par, tier_ids);
+        tier_mm      = tier_mm      ? ggml_add(ctx, tier_mm, mm)           : mm;
+        tier_par_sum = tier_par_sum ? ggml_add(ctx, tier_par_sum, par)     : par;
+        tier_chain   = tier_chain   ? ggml_add(ctx, tier_chain, chain)     : chain;
+    }
+
+    ggml_cgraph * gf = ggml_new_graph(ctx);
+    for (ggml_tensor * t : { ref_mm, ref_par, ref_chain, tier_mm, tier_par_sum, tier_chain }) {
+        ggml_build_forward_expand(gf, t);
+    }
+    bool ok = ggml_graph_compute_with_ctx(ctx, gf, n_threads) == GGML_STATUS_SUCCESS;
+
+    const struct { const char * name; ggml_tensor * ref; ggml_tensor * tier; } pairs[] = {
+        { "mul_mat_id",        ref_mm,    tier_mm      },
+        { "moe_up_gate",       ref_par,   tier_par_sum },
+        { "up_gate + down",    ref_chain, tier_chain   },
+    };
+    for (const auto & p : pairs) {
+        const bool same = ggml_nbytes(p.ref) == ggml_nbytes(p.tier) && std::memcmp(p.ref->data, p.tier->data, ggml_nbytes(p.ref)) == 0;
+        std::printf("%-8s threads=%d %-16s %s\n", ggml_type_name(type), n_threads, p.name, same ? "identical" : "DIFFERENT");
+        ok &= same;
+    }
+
+    ggml_free(ctx);
+    return ok;
+}
+
+// A split computed away from the experts copies only the active experts: ids outside [0, n_expert) have no expert to copy.
+bool check_scheduler(std::mt19937 & rng) {
+    const ggml_type type = GGML_TYPE_MXFP4;
+    size_t expert_size = 0;
+    const auto bytes = make_experts(rng, type, expert_size);
+    const auto cur_data = make_floats(rng, (size_t) n_dim * n_tokens, 1.0f);
+    std::vector<int32_t> ids_data(n_used * n_tokens);
+    for (size_t i = 0; i < ids_data.size(); ++i) {
+        ids_data[i] = i % 3 == 0 ? -1 : (int32_t) ((i * 5) % n_expert);
+    }
+
+    ggml_backend_t owner  = ggml_backend_cpu_init();
+    ggml_backend_t worker = ggml_backend_cpu_init();
+    ggml_backend_t backends[] = { worker, owner }; // the scheduler never moves a node to a lower priority backend
+
+    ggml_init_params wparams = { ggml_tensor_overhead() * 4, nullptr, true };
+    ggml_context * wctx = ggml_init(wparams);
+    ggml_tensor * experts = ggml_new_tensor_3d(wctx, type, n_dim, n_dim, n_expert);
+    ggml_backend_buffer_t wbuf = ggml_backend_alloc_ctx_tensors(wctx, owner);
+    ggml_backend_buffer_set_usage(wbuf, GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+    ggml_backend_tensor_set(experts, bytes.data(), 0, bytes.size());
+
+    ggml_init_params gparams = { ggml_tensor_overhead() * 16 + ggml_graph_overhead(), nullptr, true };
+    ggml_context * gctx = ggml_init(gparams);
+    ggml_tensor * cur = ggml_new_tensor_3d(gctx, GGML_TYPE_F32, n_dim, 1, n_tokens);
+    ggml_tensor * ids = ggml_new_tensor_2d(gctx, GGML_TYPE_I32, n_used, n_tokens);
+    ggml_set_input(cur);
+    ggml_set_input(ids);
+    ggml_tensor * out = ggml_mul_mat_id(gctx, experts, cur, ids);
+    ggml_set_output(out);
+    ggml_cgraph * gf = ggml_new_graph(gctx);
+    ggml_build_forward_expand(gf, out);
+
+    ggml_backend_sched_t sched = ggml_backend_sched_new(backends, nullptr, 2, GGML_DEFAULT_GRAPH_SIZE, false);
+    ggml_backend_sched_set_only_active_experts(sched, true);
+    // the worker no longer accepts the buffers of the owner, like a GPU with host memory: the scheduler must copy
+    worker->iface.supports_buft = [](ggml_backend_t, ggml_backend_buffer_type_t) { return false; };
+    ggml_backend_sched_set_tensor_backend(sched, out, worker);
+    bool ok = ggml_backend_sched_alloc_graph(sched, gf);
+    if (ok) {
+        ggml_backend_tensor_set(cur, cur_data.data(), 0, ggml_nbytes(cur));
+        ggml_backend_tensor_set(ids, ids_data.data(), 0, ggml_nbytes(ids));
+        ok = ggml_backend_sched_graph_compute(sched, gf) == GGML_STATUS_SUCCESS;
+    }
+    std::vector<float> result(ggml_nelements(out));
+    if (ok) {
+        ggml_backend_tensor_get(out, result.data(), 0, ggml_nbytes(out));
+    }
+    const bool split = ggml_backend_sched_get_tensor_backend(sched, out) == worker &&
+            ggml_backend_sched_get_tensor_backend(sched, experts) == owner;
+
+    // reference: the same op on one backend
+    std::vector<uint8_t> mem(64u << 20, 0xff);
+    ggml_init_params params = { mem.size(), mem.data(), false };
+    ggml_context * ctx = ggml_init(params);
+    ggml_tensor * ref_experts = ggml_new_tensor_3d(ctx, type, n_dim, n_dim, n_expert);
+    std::memcpy(ref_experts->data, bytes.data(), bytes.size());
+    ggml_tensor * ref_cur = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, n_dim, 1, n_tokens);
+    std::memcpy(ref_cur->data, cur_data.data(), ggml_nbytes(ref_cur));
+    ggml_tensor * ref_ids = ggml_new_tensor_2d(ctx, GGML_TYPE_I32, n_used, n_tokens);
+    std::memcpy(ref_ids->data, ids_data.data(), ggml_nbytes(ref_ids));
+    ggml_tensor * ref = ggml_mul_mat_id(ctx, ref_experts, ref_cur, ref_ids);
+    ggml_cgraph * rf = ggml_new_graph(ctx);
+    ggml_build_forward_expand(rf, ref);
+    ok &= ggml_graph_compute_with_ctx(ctx, rf, 2) == GGML_STATUS_SUCCESS;
+    const bool same = ok && std::memcmp(ref->data, result.data(), ggml_nbytes(ref)) == 0;
+    std::printf("scheduler, ids with -1: experts copied to the worker=%s result %s\n", split ? "yes" : "NO", same ? "identical" : "DIFFERENT");
+
+    ggml_free(ctx);
+    ggml_backend_sched_free(sched);
+    ggml_free(gctx);
+    ggml_backend_buffer_free(wbuf);
+    ggml_free(wctx);
+    ggml_backend_free(worker);
+    ggml_backend_free(owner);
+    return ok && same && split;
+}
+
+} // namespace
+
+int main() {
+    std::mt19937 rng(1234);
+    bool ok = true;
+    for (ggml_type type : { GGML_TYPE_MXFP4, GGML_TYPE_IQ2_XS, GGML_TYPE_IQ1_M }) {
+        for (int n_threads : { 1, 4 }) {
+            ok &= check_type(type, n_threads, rng);
+        }
+    }
+    ok &= check_scheduler(rng);
+    std::printf("%s\n", ok ? "PASS" : "FAIL");
+    return ok ? 0 : 1;
+}
